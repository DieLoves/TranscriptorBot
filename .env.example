# Groq
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# Telegram: fill these values before running the bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ALLOWED_USER_IDS=

# Docker Compose service address and shared container paths
TELEGRAM_BOT_API_BASE_URL=http://telegram-bot-api:8081
SQLITE_PATH=/data/transcriptbot.sqlite3
WORK_DIR=/work/jobs
TELEGRAM_FILES_DIR=/telegram

# Input and transcription limits
MAX_INPUT_BYTES=2000000000
MAX_DURATION_SECONDS=14400
GROQ_MAX_UPLOAD_BYTES=25000000
WAV_TARGET_UPLOAD_BYTES=24500000
CHUNK_SECONDS=600
SILENCE_WINDOW_SECONDS=8
SILENCE_MIN_SECONDS=0.3
PREVIEW_MAX_CHARS=3000

# Queue and retention
MAX_USER_JOBS=3
MAX_QUEUE_JOBS=30
FAILED_RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=600
STATUS_UPDATE_INTERVAL_SECONDS=5
DISK_RESERVE_BYTES=1073741824

# Retry policy and timeouts
MAX_RETRIES=5
QUOTA_RETRY_MAX_SECONDS=3600
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_READ_TIMEOUT_SECONDS=60
HTTP_MAX_REDIRECTS=5
DOWNLOAD_TIMEOUT_SECONDS=3600
GROQ_TIMEOUT_SECONDS=300
FFPROBE_TIMEOUT_SECONDS=60
FFMPEG_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO
